.w-75.view-center
  = simple_form_for @static_page_variable do |f|
    = f.input :key, label: t("static_page_variable.key"), input_html: { autocomplete: "off" }
    = f.input :variable_type, label: t("static_page_variable.variable_type"), collection: StaticPageVariable.variable_types.keys.map { |type| [type.humanize, type] }, include_blank: false
    .js-static-page-variable-text-field
      = f.input :value, label: t("static_page_variable.text_value")
    .js-static-page-variable-image-field
      = f.input :image, as: :file, label: t("static_page_variable.image"), input_html: { accept: "image/*" }

    - if @static_page_variable.image.present?
      .mb-3
        = image_tag @static_page_variable.image.url, class: "img-fluid border rounded", style: "max-height: 200px;"

    = f.input :description, label: t("static_page_variable.description"), input_html: { rows: 3 }

    .actions
      = link_to t("shared.cancel"), static_page_variables_path, class: "btn btn-secondary"
      = f.submit t("shared.save"), class: "btn btn-primary"
