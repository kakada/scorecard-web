.d-flex.flex-lg-row.flex-column
  .flex-1.mr-lg-4
    = simple_form_for @static_page do |f|
      = f.input :slug, label: t("static_page.slug"), input_html: { autocomplete: "off" }

      .form-group
        %label.d-block= t("static_page.content")
        %ul.nav.nav-pills.lang-switch.mb-3{ role: "tablist" }
          %li.nav-item
            %a#content-km-tab.nav-link.active{ "data-toggle" => "pill", href: "#content-km-pane", role: "tab", "aria-controls" => "content-km-pane", "aria-selected" => "true", "data-preview-source" => "km" }= t("static_page.km_locale")
          %li.nav-item
            %a#content-en-tab.nav-link{ "data-toggle" => "pill", href: "#content-en-pane", role: "tab", "aria-controls" => "content-en-pane", "aria-selected" => "false", "data-preview-source" => "en" }= t("static_page.en_locale")

        .tab-content
          #content-km-pane.tab-pane.fade.show.active{ role: "tabpanel", "aria-labelledby" => "content-km-tab" }
            = f.input :content_km, as: :text, label: false, input_html: { rows: 20, class: "static-page-editor", "data-preview-input" => "km" }, placeholder: t("static_page.content_placeholder")
          #content-en-pane.tab-pane.fade{ role: "tabpanel", "aria-labelledby" => "content-en-tab" }
            = f.input :content_en, as: :text, label: false, input_html: { rows: 20, class: "static-page-editor", "data-preview-input" => "en" }, placeholder: t("static_page.content_placeholder")

      .card.shadow-sm.border-0.mb-3
        .card-body.py-3
          .d-flex.justify-content-between.align-items-center.flex-wrap
            %div
              .font-weight-bold= t("static_page.available_variables")
              %small.text-muted= t("static_page.insert_variable_hint")
            = link_to t("static_page.manage_variables"), static_page_variables_path, class: "btn btn-outline-secondary btn-sm"

          - if @static_page_variables.present?
            .static-page-variables.mt-3
              - @static_page_variables.each do |static_page_variable|
                %button.btn.btn-light.btn-sm.static-page-variable-token.mr-2.mb-2{ type: "button", "data-token" => static_page_variable.token }
                  %code= static_page_variable.token
          - else
            %p.text-muted.mb-0.mt-3= t("static_page.no_variables")

      .actions
        = link_to t("shared.cancel"), static_pages_path, class: "btn btn-secondary"
        = f.submit t("shared.save"), class: "btn btn-primary"

  .flex-1
    .card
      .card-header.font-weight-bold
        %i.fas.fa-eye
        = t("static_page.preview")
      .card-body
        .static-page-preview-area{"data-static-page-preview" => true, "data-preview-url" => preview_static_pages_path}= @static_page.rendered_content_by_locale(:km).html_safe
