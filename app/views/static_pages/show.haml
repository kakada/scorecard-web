- content_for :title do
  = @static_page.slug

.d-flex.justify-content-end.mb-2
  = link_to t("shared.edit"), edit_static_page_path(@static_page), class: "btn btn-warning"

.card.shadow.mb-4
  .card-body
    .mb-4
      %h6.text-gray-800.font-weight-bold= t("static_page.slug")
      %code= @static_page.slug

    .row
      .col-lg-6
        %h6.text-gray-800.font-weight-bold= t("static_page.content_km")
        .border.rounded.p-3.static-page-rendered-html
          = sanitize(@static_page.content_km, attributes: %w[href src style class alt title target rel], tags: %w[a p div span h1 h2 h3 h4 h5 h6 ul ol li strong em b i u table thead tbody tr th td img hr br blockquote pre code])
      .col-lg-6
        %h6.text-gray-800.font-weight-bold= t("static_page.content_en")
        .border.rounded.p-3.static-page-rendered-html
          = sanitize(@static_page.content_en, attributes: %w[href src style class alt title target rel], tags: %w[a p div span h1 h2 h3 h4 h5 h6 ul ol li strong em b i u table thead tbody tr th td img hr br blockquote pre code])
