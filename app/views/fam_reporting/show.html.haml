= content_for :title do
  = t("fam_reporting.page_title")

#content.mx-auto{style: "width: fit-content;"}
  .d-flex.my-4
    - back_url = user_signed_in? ? fam_reporting_stats_path : new_user_session_path
    = link_to t("shared.back"), back_url

  .card.shadow.mb-4
    .card-body
      - if @content.present?
        = sanitize(@content, attributes: %w[href src style class alt title target rel], tags: %w[a p div span h1 h2 h3 h4 h5 h6 ul ol li strong em b i u table thead tbody tr th td img hr br blockquote pre code])
      - else
        %p.text-muted.mb-0= t("fam_reporting.content_not_available")
