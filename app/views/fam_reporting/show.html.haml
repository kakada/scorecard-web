= content_for :title do
  = t("fam_reporting.page_title")

#content.mx-auto{style: 'width: fit-content;'}
  .d-flex.my-4
    - back_url = user_signed_in? ? fam_reporting_stats_path : new_user_session_path
    = link_to t('shared.back'), back_url

  .fam-poster
    %style
      :plain
        @import url('https://fonts.googleapis.com/css2?family=Moul&family=Noto+Sans+Khmer:wght@400;500;600;700&family=Poppins:wght@400;600;700;800&display=swap');

        .fam-poster {
          --fam-orange: #E1691A;
          --fam-orange-dark: #B84E10;
          --fam-navy: #1E2A44;
          --fam-cream: #F7F2E6;
          --fam-band: #F3E6D8;
          --fam-tan: #E7B84A;
          --fam-text: #2B2620;
          --fam-rule: #1E2A44;

          max-width: 880px;
          margin: 0 auto 2rem;
          background: var(--fam-cream);
          color: var(--fam-text);
          font-family: 'Noto Sans Khmer', 'Poppins', sans-serif;
          line-height: 1.6;
          box-sizing: border-box;
        }
        .fam-poster *, .fam-poster *::before, .fam-poster *::after {
          box-sizing: inherit;
        }

        .fam-header {
          display: flex;
          align-items: center;
          gap: 28px;
          padding: 32px 40px 24px;
        }
        .fam-logo {
          width: 110px;
          height: auto;
          flex-shrink: 0;
        }
        .fam-title-km {
          margin: 0 0 6px;
          font-family: 'Moul', 'Noto Sans Khmer', serif;
          font-weight: 400;
          font-size: 2rem;
          line-height: 1.35;
          color: var(--fam-text);
        }
        .fam-title-en {
          margin: 0;
          font-family: 'Poppins', sans-serif;
          font-weight: 800;
          font-size: 1.5rem;
          color: var(--fam-orange);
          letter-spacing: 0.01em;
        }
        .fam-divider {
          height: 4px;
          background: var(--fam-navy);
          margin: 0 40px 28px;
        }
        .fam-body {
          padding: 0 40px;
        }
        .fam-intro {
          margin: 0 0 28px;
          font-size: 1.05rem;
        }
        .fam-callout {
          display: flex;
          align-items: flex-start;
          gap: 14px;
          margin-bottom: 0;
        }
        .fam-callout__icon {
          flex-shrink: 0;
          width: 34px;
          height: 34px;
          border: 3px solid var(--fam-text);
          border-radius: 6px;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 1.1rem;
          color: var(--fam-text);
          margin-top: 2px;
        }
        .fam-callout p {
          margin: 4px 0 0;
          font-size: 1.05rem;
        }
        .fam-bullets {
          background: var(--fam-band);
          margin: 20px -40px 0;
          padding: 24px 40px;
          display: flex;
          flex-direction: column;
          gap: 18px;
        }
        .fam-bullet {
          display: flex;
          align-items: flex-start;
          gap: 16px;
        }
        .fam-bullet__icon {
          flex-shrink: 0;
          color: var(--fam-orange);
          font-size: 1.4rem;
          font-weight: 700;
          line-height: 1.5;
        }
        .fam-bullet p {
          margin: 0;
          font-size: 1.02rem;
        }
        .fam-confidential {
          display: flex;
          align-items: center;
          gap: 16px;
          border: 2px solid var(--fam-orange);
          border-radius: 999px;
          padding: 16px 32px;
          margin: 28px 0 32px;
        }
        .fam-confidential__icon {
          flex-shrink: 0;
          color: var(--fam-orange);
          font-size: 1.6rem;
          transform: scaleX(-1);
        }
        .fam-confidential p {
          margin: 0;
          font-size: 0.98rem;
          text-align: center;
        }
        .fam-footer {
          display: grid;
          grid-template-columns: 1.5fr 1fr;
        }
        .fam-footer__contact {
          background: var(--fam-orange);
          color: #fff;
          padding: 28px 36px;
          display: flex;
          flex-direction: column;
          gap: 16px;
        }
        .fam-contact-item {
          display: flex;
          align-items: flex-start;
          gap: 14px;
        }
        .fam-contact-item__icon {
          flex-shrink: 0;
          width: 26px;
          height: 26px;
          margin-top: 2px;
        }
        .fam-contact-item p {
          margin: 0;
          font-size: 0.98rem;
        }
        .fam-contact-intro {
          margin: 6px 0 0;
          font-size: 0.98rem;
        }
        .fam-contact-methods {
          display: flex;
          flex-direction: column;
          gap: 8px;
          margin-top: 2px;
        }
        .fam-contact-methods a {
          color: #fff;
          text-decoration: underline;
        }
        .fam-contact-method {
          display: flex;
          align-items: center;
          gap: 10px;
          font-weight: 700;
          font-size: 1.02rem;
        }
        .fam-contact-method__icon {
          width: 22px;
          height: 22px;
        }
        .fam-footer__qr {
          background: var(--fam-tan);
          padding: 28px 24px;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          gap: 16px;
          text-align: center;
        }
        .fam-footer__qr h3 {
          margin: 0;
          font-family: 'Poppins', sans-serif;
          font-weight: 700;
          font-size: 1.05rem;
          color: var(--fam-text);
        }
        .fam-qr {
          width: 160px;
          height: 160px;
          background: #fff;
          padding: 8px;
          border-radius: 4px;
        }
        .fam-bottom-bar {
          background: var(--fam-navy);
          color: #fff;
          text-align: center;
          padding: 14px 20px;
          font-family: 'Poppins', sans-serif;
          font-weight: 600;
          font-size: 0.92rem;
        }
        .fam-bottom-bar a {
          color: #fff;
        }
        .fam-bottom-bar p {
          margin: 2px 0;
        }
        @media (max-width: 640px) {
          .fam-header {
            flex-direction: column;
            text-align: center;
            padding: 24px 20px 20px;
          }
          .fam-divider { margin: 0 20px 20px; }
          .fam-body { padding: 0 20px; }
          .fam-bullets { margin: 20px -20px 0; padding: 20px; }
          .fam-confidential { flex-direction: column; text-align: center; padding: 16px 20px; }
          .fam-footer { grid-template-columns: 1fr; }
          .fam-footer__contact, .fam-footer__qr { padding: 24px 20px; }
        }

    .fam-header
      = image_tag "care_logo.png", alt: "CARE International logo", class: "fam-logo"
      .fam-header__title
        %h1.fam-title-km យន្តការនៃការផ្តល់ព័ត៌មាន និងគណនេយ្យភាព
        %h2.fam-title-en Feedback and Accountability Mechanism (FAM)

    .fam-divider

    .fam-body
      %p.fam-intro
        យន្តការនៃការផ្តល់ព័ត៌មាន និងគណនេយ្យភាពគឺជាយន្តការមួយដើម្បីអនុញ្ញាតឱ្យសមាជិកសហគមន៍
        អាជ្ញាធរ ឬអង្គការដៃគូ រាយការណ៍ពីកង្វល់ ឬឥរិយាបថដែលមិនសមរម្យរបស់បុគ្គលិកអង្គការឃែរ
        ឬមតិយោបល់ផ្សេងៗ អំពីការងាររបស់អង្គការឃែរ។

      .fam-callout
        %span.fam-callout__icon →
        %p
          ប្រសិនបើអ្នកឃើញនូវសកម្មភាពគម្រោង ឬឥរិយាបថរបស់បុគ្គលិកអង្គការឃែរ
          ដែលមិនសមរម្យ អាចមានដូចជា៖

      .fam-bullets
        .fam-bullet
          %span.fam-bullet__icon →
          %p
            ករណីពាក់ព័ន្ធនឹងការអនុវត្តគម្រោង ផល់ប៉ះពាល់ លទ្ធផល ការសរសើរឬស្នើសុំព័ត៌មាន។
        .fam-bullet
          %span.fam-bullet__icon →
          %p
            អំពើលួច កេងបន្លំលុយកាក់ ទ្រព្យសម្បត្តិ ឬមានទំនាស់ផលប្រយោជន៍។
        .fam-bullet
          %span.fam-bullet__icon →
          %p
            អំពើបៀតបៀន រើសអើងលើរាងកាយ ផ្លូវភេទ ឬផ្លូវអារម្មណ៍ ឬការមិនយកចិត្តទុកដាក់លើ
            ករណីទាំងអស់នេះ រួមទាំងកុមារផងដែរ។

      .fam-confidential
        %span.fam-confidential__icon ↳
        %p
          រាល់អត្តសញ្ញាណរបស់អ្នករាយការណ៍ នឹងត្រូវបានរក្សាជាការសម្ងាត់ ហើយអ្នកនឹងមិនត្រូវបាន
          បាត់បង់ផលប្រយោជន៍អ្វី ពីគម្រោងដែលអង្គការឃែរផ្តល់ជូនឡើយ

    .fam-footer
      .fam-footer__contact
        .fam-contact-item
          %svg.fam-contact-item__icon{ viewBox: "0 0 24 24", fill: "none", stroke: "#fff", "stroke-width" => "1.8" }
            %path{ d: "M9 18h6M10 21h4M12 3a6 6 0 00-4 10.5c.6.6 1 1.4 1 2.5h6c0-1.1.4-1.9 1-2.5A6 6 0 0012 3z" }
          %p ជូនដំណឹងដល់បុគ្គលិកអង្គការឃែរណាម្នាក់ដែលទុកចិត្ត
        .fam-contact-item
          %svg.fam-contact-item__icon{ viewBox: "0 0 24 24", fill: "none", stroke: "#fff", "stroke-width" => "1.8" }
            %path{ d: "M3 11v2a1 1 0 001 1h2l5 4V6L6 10H4a1 1 0 00-1 1zM15 8a4 4 0 010 8M18 5a8 8 0 010 14" }
          %p ការប្រជុំពេលចុះប្រមូលទិន្នន័យ ឬពេលមានសកម្មភាពរបស់គម្រោង

        %p.fam-contact-intro សូមទាក់ទងមកអង្គការឃែរកម្ពុជា តាមរយៈ៖

        .fam-contact-methods
          .fam-contact-method
            %svg.fam-contact-method__icon{ viewBox: "0 0 24 24", fill: "none", stroke: "#fff", "stroke-width" => "1.8" }
              %path{ d: "M4 5c0 8.284 6.716 15 15 15l3-3-5-4-2 2c-2-1-4-3-5-5l2-2-4-5-3 3z", "stroke-linejoin" => "round" }
            %span (+855) 061 287 280
          .fam-contact-method
            %svg.fam-contact-method__icon{ viewBox: "0 0 24 24", fill: "none", stroke: "#fff", "stroke-width" => "1.8" }
              %path{ d: "M3 6h18v12H3zM3 6l9 7 9-7", "stroke-linejoin" => "round" }
            %a{ href: "mailto:FAM.CC@CARE.ORG" } FAM.CC@CARE.ORG

      .fam-footer__qr
        %h3 សូមស្កេននៅទីនេះ
        = image_tag "qr-code.png", alt: "QR code linking to the CARE FAM report form", class: "fam-qr"

    .fam-bottom-bar
      %p
        រាយការណ៍ទៅឃែរអន្តរជាតិផ្ទាល់៖
        %a{ href: "https://www.care.ethicspoint.com", target: "_blank", rel: "noopener" } WWW.CARE.ETHICSPOINT.COM
      %p លេខទូរស័ព្ទ: +1800209719
