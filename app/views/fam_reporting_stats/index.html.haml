- content_for :title do
  = t("fam_reporting.statistics_title")

.card.shadow.mb-4
  .card-body
    %table.table.table-hover.pretty
      %thead
        %tr
          %th= t("fam_reporting.source")
          %th= t("fam_reporting.views_count")
          %th= t("shared.updated_at")

      %tbody
        - @fam_reporting_stats.each do |stat|
          %tr
            %td= t("fam_reporting.sources.#{stat.source}")
            %td= stat.views_count
            %td= timeago(stat.updated_at, "datetime").html_safe
